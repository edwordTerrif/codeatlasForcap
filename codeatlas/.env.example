# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.
# LLM 없이도(LLM_PROVIDER=none) 지도·검색·투어는 모두 동작합니다.

# --- LLM 선택: none | anthropic | openai | ollama ---
LLM_PROVIDER=none

# Claude를 쓸 때
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=여기에-키
# LLM_MODEL=claude-haiku-5-5

# OpenAI 또는 OpenAI 호환 서비스를 쓸 때 (모델 이름은 직접 지정)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=여기에-키
# LLM_MODEL=사용할-모델-이름
# LLM_BASE_URL=https://api.openai.com/v1

# 내 컴퓨터의 Ollama를 쓸 때 (무료, 인터넷 불필요. 먼저 ollama pull qwen2.5-coder:7b)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:7b

# --- 비용·속도 조절 ---
# 중요도 상위 몇 개의 함수·클래스와 파일을 LLM으로 요약할지 (나머지는 docstring으로 자동 요약)
SUMMARY_MAX_ENTITIES=120
SUMMARY_MAX_FILES=60
# 요약을 동시에 몇 개씩 요청할지 (Ollama처럼 느린 로컬 모델이면 1~2 추천)
SUMMARY_WORKERS=4

# 분석 결과·내려받은 저장소를 둘 폴더 (기본: backend/data)
# DATA_DIR=
